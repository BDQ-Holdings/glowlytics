{
  "name": "glowlytics",
  "private": true,
  "workspaces": [
    "apps/glowlytics",
    "apps/glowlytics/backend"
  ],
  "scripts": {
    "start": "node apps/glowlytics/backend/server.js",
    "mobile:start": "npm --prefix apps/glowlytics run start",
    "mobile:typecheck": "npm --prefix apps/glowlytics run typecheck",
    "mobile:test": "npm --prefix apps/glowlytics run test",
    "backend:dev": "npm --prefix apps/glowlytics/backend run dev",
    "backend:test": "npm --prefix apps/glowlytics/backend run test",
    "landing:dev": "npm --prefix apps/landing run dev",
    "landing:build": "npm --prefix apps/landing run build",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "expo": "~54.0.34",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0"
  },
  "version": "1.0.0"
}
