{
  "name": "glowlytics-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node db-init.js",
    "postinstall": "bash scripts/download-models.sh || echo 'Model download skipped'",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@ide/backoff": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pinecone-database/pinecone": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "expo-dev-menu-interface": "^2.0.0",
    "expo-updates-interface": "^2.0.0",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.1.0",
    "openai": "^6.27.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "maxWorkers": 1,
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/__mocks__/uuid.js",
      "^jwks-rsa$": "<rootDir>/__mocks__/jwks-rsa.js"
    }
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.24.3"
  }
}
