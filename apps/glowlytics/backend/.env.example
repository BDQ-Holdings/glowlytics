# MCP server (Audience B — user-scoped, read-only)
MCP_ENABLED=false
MCP_BASE_URL=https://api.glowlytics.ai
# Comma-separated Clerk user IDs allowed during closed beta (MCP-06).
# NOTE: an empty list NO LONGER means GA. With it empty, MCP denies everyone
# (beta_only) unless MCP_BETA_OPEN=true is set explicitly (see below).
MCP_BETA_USER_IDS=
# MCP-06: explicit General Availability switch. Set to 'true' to allow ALL
# authenticated users when MCP_BETA_USER_IDS is empty. Leave unset/false to
# keep MCP locked to the beta allowlist (fail-closed default).
MCP_BETA_OPEN=
# Optional override; defaults to <CLERK_ISSUER_URL>/.well-known/jwks.json
# CLERK_JWKS_URL=
# MCP-01: redirect_uri allowlist for the OAuth DCR proxy. Comma-separated, exact
# https URIs. When empty, falls back to built-in defaults for the known-good MCP
# connectors: https://claude.ai/api/mcp/auth_callback and
# https://claude.com/api/mcp/auth_callback. Loopback (http://localhost:* /
# http://127.0.0.1:*, any port) is ALWAYS accepted for the MCP Inspector.
# MCP_OAUTH_PROXY_REDIRECT_URIS=

# ==================== Database TLS (BC-002) ====================
# PEM-encoded CA certificate for the Postgres provider. When set, the app
# verifies the DB server certificate against it (rejectUnauthorized: true).
# Recommended for production. Railway/Neon/Supabase expose a downloadable CA.
DATABASE_CA_CERT=
# If you have no CA cert but the DB cert chains to a public/system CA, set this
# to 'true' to still enforce verification. Ignored when DATABASE_CA_CERT is set.
# When both are unset, TLS is used without cert verification (insecure; logged).
DATABASE_SSL_REJECT_UNAUTHORIZED=

# ==================== Auth (BC-003 / BC-005) ====================
# Comma-separated list of allowed CORS origins. REQUIRED in production — the
# server refuses to boot if NODE_ENV=production and this is empty.
CORS_ORIGINS=
# Expected JWT audience (Clerk `aud` claim). When set, tokens minted for a
# different audience are rejected. Leave unset to skip audience pinning.
CLERK_AUDIENCE=
